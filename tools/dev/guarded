#!/usr/bin/env bash
# Run a heavy command (build, test, game run) inside a capped systemd user scope, so a runaway
# process tree gets killed inside its own cgroup instead of freezing the whole desktop.
#
#   tools/dev/guarded [--mem 16G] [--tasks 2048] -- <command...>
#
# Defaults leave room for the desktop on the 32 GB dev machine. Lower priority (nice/ionice)
# keeps the UI responsive while a build runs. Falls back to plain ulimits if systemd-run is
# unavailable (CI containers): the process limit still stops a fork bomb.
set -euo pipefail

mem="${GUARDED_MEM:-16G}"
tasks="${GUARDED_TASKS:-2048}"
while [[ $# -gt 0 ]]; do
    case "$1" in
        --mem) mem="$2"; shift 2 ;;
        --tasks) tasks="$2"; shift 2 ;;
        --) shift; break ;;
        *) break ;;
    esac
done
[[ $# -gt 0 ]] || { echo "usage: $0 [--mem 16G] [--tasks 2048] -- <command...>" >&2; exit 2; }

if command -v systemd-run >/dev/null 2>&1 && systemd-run --user --scope --quiet -p TasksMax=8 -- true 2>/dev/null; then
    exec systemd-run --user --scope --quiet \
        -p MemoryMax="$mem" -p MemorySwapMax=0 -p TasksMax="$tasks" -p CPUWeight=20 -p IOWeight=20 \
        -- nice -n 10 "$@"
fi
ulimit -u "$tasks" 2>/dev/null || true
exec nice -n 10 "$@"
